{
  "permissions": {
    "deny": [
      "Read(~/.claude/claude-notify.json)",
      "Read(~/.claude/history.jsonl)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*.pem)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.npmrc)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.development.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.production.local)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.staging.local)",
      "Read(//**/.env.test)",
      "Read(//**/.env.test.local)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(brew install:*)",
      "Bash(brew reinstall:*)",
      "Bash(brew upgrade:*)",
      "Bash(brew uninstall:*)",
      "Bash(brew tap:*)",
      "Bash(npm install -g:*)",
      "Bash(npm install --global:*)",
      "Bash(npm i -g:*)",
      "Bash(pnpm add -g:*)",
      "Bash(pnpm add --global:*)",
      "Bash(pnpm install -g:*)",
      "Bash(yarn global:*)",
      "Bash(pip install --user:*)",
      "Bash(pip3 install --user:*)",
      "Bash(pipx install:*)",
      "Bash(uv tool install:*)",
      "Bash(cargo install:*)",
      "Bash(gem install:*)",
      "Bash(go install:*)",
      "Bash(nix profile:*)",
      "Bash(nix-env:*)",
      "Bash(darwin-rebuild:*)",
      "Bash(home-manager:*)"
    ]
  },
  "model": "claude-fable-5-1",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "hooks": {
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/pr-mode.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/pr-mode.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/pr-mode.sh"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/guard-destructive.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/pr-mode.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/validate-claude-config.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/pr-mode.sh"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "effortLevel": "high",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
